root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

[*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,astro,vue,svelte}]
quote_type = single

[*.{json,jsonc,json5}]
max_line_length = off

[*.{yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
max_line_length = off

[Makefile]
indent_style = tab
