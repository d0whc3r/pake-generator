{
  "name": "pake-generator",
  "version": "1.0.0",
  "private": true,
  "description": "Registry and tooling to generate, install and maintain macOS desktop apps with Pake",
  "keywords": [
    "desktop-apps",
    "macos",
    "pake",
    "tauri"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/d0whc3r/pake-generator.git"
  },
  "type": "module",
  "scripts": {
    "pake": "tsx src/cli.ts",
    "pake:built": "node dist-cli/cli.mjs",
    "build": "tsdown",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "lint": "oxlint --no-error-on-unmatched-pattern",
    "lint:fix": "oxlint --no-error-on-unmatched-pattern --fix",
    "format": "oxfmt --no-error-on-unmatched-pattern",
    "format:check": "oxfmt --no-error-on-unmatched-pattern --check",
    "format:fix": "pnpm lint:fix --fix-suggestions && pnpm format",
    "prepare": "husky"
  },
  "devDependencies": {
    "@oclif/core": "4.14.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@total-typescript/ts-reset": "0.6.1",
    "@types/node": "26.3.0",
    "@vitest/coverage-v8": "4.1.11",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "oclif": "4.24.0",
    "oxfmt": "0.66.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "pake-cli": "3.15.7",
    "semantic-release": "25.0.9",
    "tsdown": "0.22.14",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "lint-staged": {
    "*": [
      "oxlint --no-error-on-unmatched-pattern --fix --fix-suggestions",
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "oclif": {
    "bin": "pake",
    "commands": "./src/commands",
    "dirname": "pake-apps",
    "topicSeparator": " "
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.26.2"
}
