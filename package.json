{
  "name": "pake-generator",
  "version": "1.0.0",
  "private": true,
  "description": "Registro y herramientas para generar, instalar y mantener apps de escritorio en macOS con Pake",
  "keywords": [
    "desktop-apps",
    "macos",
    "pake",
    "tauri"
  ],
  "license": "MIT",
  "type": "module",
  "scripts": {
    "pake": "tsx src/cli.ts",
    "pake:built": "node dist-cli/cli.mjs",
    "build": "tsdown",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "lint": "oxlint --no-error-on-unmatched-pattern",
    "lint:fix": "oxlint --no-error-on-unmatched-pattern --fix",
    "format": "oxfmt --no-error-on-unmatched-pattern",
    "format:check": "oxfmt --no-error-on-unmatched-pattern --check",
    "format:fix": "pnpm lint:fix --fix-suggestions && pnpm format"
  },
  "devDependencies": {
    "@oclif/core": "4.13.2",
    "@total-typescript/ts-reset": "0.6.1",
    "@types/node": "26.1.2",
    "oclif": "4.23.29",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "pake-cli": "3.15.5",
    "tsdown": "0.22.14",
    "tsx": "4.23.5",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "oclif": {
    "bin": "pake",
    "commands": "./dist-cli/commands",
    "dirname": "pake-apps",
    "topicSeparator": " "
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.26.2"
}
