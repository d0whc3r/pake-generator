+// Mirrors the routing event.js applies to links: internal_url_regex (compiled
+// by the CLI from --safe-domain) decides what may stay inside the app. An
+// empty or invalid pattern means "everything http(s) is external", which
+// matches the JS fallback to plain domain checks failing closed here.
+fn is_internal_popup_url(internal_pattern: &str, url: &str) -> bool {
+    if internal_pattern.is_empty() {
+        return false;
+    }
+    match regex::Regex::new(internal_pattern) {
+        Ok(pattern) => pattern.is_match(url),
+        Err(error) => {
+            eprintln!("[Pake] Invalid internal_url_regex \"{internal_pattern}\": {error}");
+            false
+        }
+    }
+}
