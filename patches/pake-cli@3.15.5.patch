+// Popups built by wry from the WKWebViewConfiguration WebKit hands over never
+// get a WKUIDelegate, and a webview without one falls back to WebKit's own
+// microphone/camera prompt on every load (a Slack huddle window asks each time
+// it opens). Hand those popups the delegate of the webview that already has
+// one: wry's, which grants capture without asking. Runs on the main queue so
+// the popup exists by the time it looks for it.
+#[cfg(target_os = "macos")]
+fn share_ui_delegate_with_popups() {
+    use objc2::runtime::AnyObject;
+    use objc2::{class, msg_send, sel};
+
+    unsafe fn collect_webviews(view: *mut AnyObject, found: &mut Vec<*mut AnyObject>) {
+        if view.is_null() {
+            return;
+        }
+        let is_webview: bool = msg_send![view, respondsToSelector: sel!(setUIDelegate:)];
+        if is_webview {
+            found.push(view);
+        }
+        let subviews: *mut AnyObject = msg_send![view, subviews];
+        let count: usize = msg_send![subviews, count];
+        for index in 0..count {
+            let subview: *mut AnyObject = msg_send![subviews, objectAtIndex: index];
+            collect_webviews(subview, found);
+        }
+    }
+
+    Queue::main().exec_async(|| unsafe {
+        let ns_app: *mut AnyObject = msg_send![class!(NSApplication), sharedApplication];
+        let windows: *mut AnyObject = msg_send![ns_app, windows];
+        let window_count: usize = msg_send![windows, count];
+
+        let mut webviews = Vec::new();
+        for index in 0..window_count {
+            let window: *mut AnyObject = msg_send![windows, objectAtIndex: index];
+            let content_view: *mut AnyObject = msg_send![window, contentView];
+            collect_webviews(content_view, &mut webviews);
+        }
+
+        let mut delegate: *mut AnyObject = std::ptr::null_mut();
+        for webview in &webviews {
+            let current: *mut AnyObject = msg_send![*webview, UIDelegate];
+            if !current.is_null() {
+                delegate = current;
+                break;
+            }
+        }
+        if delegate.is_null() {
+            return;
+        }
+
+        for webview in webviews {
+            let current: *mut AnyObject = msg_send![webview, UIDelegate];
+            if current.is_null() {
+                let _: () = msg_send![webview, setUIDelegate: delegate];
+            }
+        }
+    });
+}
