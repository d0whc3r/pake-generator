-            match open_requested_window(
-                &app_handle,
-                &popup_config,
-                &popup_tauri_config,
-                target_url,
-                features,
-            ) {
-                Ok(window) => NewWindowResponse::Create { window },
-                Err(error) => {
-                    eprintln!("[Pake] Failed to open requested window: {error}");
-                    NewWindowResponse::Deny
-                }
-            }
+        // Building the popup as a Tauri window crashes on macOS 26 either way:
+        // reusing the opener WKWebViewConfiguration registers its script message
+        // handlers twice, and creating our own makes WebKit abort inside
+        // createNewPage because it only accepts the configuration it handed over
+        // (see the comment about issue #1194 further down, and the Allow branch
+        // of wry's WKUIDelegate). Allow lets wry build the window from that
+        // configuration, which is also what gives the page a real window.opener
+        // and a resizable window sized from the window features.
+        window_builder = window_builder.on_new_window(|_target_url, _features| {
+            #[cfg(target_os = "macos")]
+            share_ui_delegate_with_popups();
+            NewWindowResponse::Allow
         });
     }
 
